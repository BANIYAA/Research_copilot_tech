# Gemini API Key (Required for planning, synthesis, and grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Search API Key (Tavily or Serper if using external search provider)
# If not provided, ResearchPilot uses DuckDuckGo / Gemini Google Search Grounding.
SEARCH_API_KEY=your_search_api_key_here

# Execution configuration
MAX_RETRIES=2
SIMULATE_FAILURE=false
